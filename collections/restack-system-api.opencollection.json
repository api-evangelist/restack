{
  "opencollection": "1.0.0",
  "info": {
    "name": "Restack Agents System API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "System",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health Check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:6233/health"
          },
          "docs": "Returns the health status of the Restack server."
        }
      ]
    }
  ],
  "bundled": true
}